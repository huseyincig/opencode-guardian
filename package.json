{
  "name": "opencode-guardian",
  "version": "0.18.6",
  "description": "Autonomous quality, discipline, and runtime security guardian plugin for OpenCode V2 AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    },
    "./rpc": {
      "import": "./dist/intervention-rpc.js",
      "types": "./dist/intervention-rpc.d.ts"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "index.js",
    "tui.js",
    "scripts/guardian-status.mjs"
  ],
  "scripts": {
    "build": "node -e \"import('node:fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\" && tsc",
    "postbuild": "node scripts/emit-tui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "prepack": "npm run build",
    "lint": "oxlint src tests --deny-warnings",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters --noUncheckedIndexedAccess --exactOptionalPropertyTypes",
    "verify": "npm run typecheck:strict && npm run lint && npm test && node scripts/check-docs.mjs"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-guardian",
    "ai-agents",
    "guardian",
    "guard",
    "linter",
    "code-quality",
    "safety",
    "security",
    "guardrails"
  ],
  "author": "Hüseyin Hadi Çığ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huseyincig/opencode-guardian.git"
  },
  "bugs": {
    "url": "https://github.com/huseyincig/opencode-guardian/issues"
  },
  "homepage": "https://github.com/huseyincig/opencode-guardian#readme",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/plugin": "^2.4.1",
    "@opentui/core": "^0.9.9",
    "@opentui/solid": "^0.9.9",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "^1.9.12",
    "oxlint": "1.87.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.8.0"
  },
  "bin": {
    "opencode-guardian-status": "scripts/guardian-status.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.3.0",
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "seroval": "1.6.8",
    "ip-address": "^10.7.4",
    "toml": "^5.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
